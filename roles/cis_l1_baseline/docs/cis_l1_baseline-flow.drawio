A5868&quot;&gt;playbooks/smoke.yml → files/cis-l1-smoke.sh&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#4A5868&quot;&gt;defaults/main.yml → every tunable, commented&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFDE7;strokeColor=#B08800;fontSize=13;arcSize=10;fontFamily=Segoe UI;fontColor=#1B2733;align=center;strokeWidth=1.5;spacing=6;" vertex="1" parent="1"><mxGeometry x="640" y="736" width="480" height="120" as="geometry"/></mxCell><mxCell id="lg1" value="&lt;b&gt;access-critical&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDECEA;strokeColor=#C62828;fontSize=12;arcSize=10;fontFamily=Segoe UI;fontColor=#1B2733;align=center;strokeWidth=1.5;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="814" width="112" height="36" as="geometry"/></mxCell><mxCell id="lg2" value="&lt;b&gt;system settings&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF1FB;strokeColor=#2B5797;fontSize=12;arcSize=10;fontFamily=Segoe UI;fontColor=#1B2733;align=center;strokeWidth=1.5;spacing=6;" vertex="1" parent="1"><mxGeometry x="162" y="814" width="112" height="36" as="geometry"/></mxCell><mxCell id="lg3" value="&lt;b&gt;verification&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;fontSize=12;arcSize=10;fontFamily=Segoe UI;fontColor=#1B2733;align=center;strokeWidth=1.5;spacing=6;" vertex="1" parent="1"><mxGeometry x="284" y="814" width="112" height="36" as="geometry"/></mxCell><mxCell id="lg4" value="&lt;b&gt;optional&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#607D8B;fontSize=12;arcSize=10;fontFamily=Segoe UI;fontColor=#1B2733;align=center;strokeWidth=1.5;spacing=6;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="406" y="814" width="114" height="36" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
