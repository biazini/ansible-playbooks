<mxfile host="vscode" agent="diagrams.py"><diagram id="cis_l1_baseline-flow" name="cis_l1_baseline-flow"><mxGraphModel dx="1240" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1240" pageHeight="900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Role cis_l1_baseline — Task Flow" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#1F3A5F;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="20" y="8" width="1200" height="34" as="geometry"/></mxCell><mxCell id="subtitle" value="tasks/main.yml · access-critical steps first and last · (tag) runs only that part, e.g. --tags ssh,sudo" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#4A5868;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="20" y="40" width="1200" height="20" as="geometry"/></mxCell><mxCell id="s1" value="&lt;b&gt;1 · preflight.yml (always)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#4A5868&quot;&gt;release · required vars · controller IP in mgmt CIDRs&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#4A5868&quot;&gt;connecting user passes AllowGroups&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDECEA;strokeColor=#C62828;fontSize=13;arcSize=10;fontFamily=Segoe UI;fontColor=#1B2733;align=center;strokeWidth=1.5;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="480" height="62" as="geometry"/></mxCell><mxCell id="s2" value="&lt;b&gt;2 · automation_user.yml (accounts)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#4A5868&quot;&gt;svc_ansible: key-only, never expires&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#4A5868&quot;&gt;NOPASSWD sudo · also used by bootstrap.yml&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDECEA;strokeColor=#C62828;fontSize=13;arcSize=10;fontFamily=Segoe UI;fontColor=#1B2733;align=center;strokeWidth=1.5;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="170" width="480" height="62" as="geometry"/></mxCell><mxCell id="s3" value="&lt;b&gt;3 · packages.yml (packages)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#4A5868&quot;&gt;tooling in · legacy services out&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#4A5868&quot;&gt;one firewall · one time daemon · apport off&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF1FB;strokeColor=#2B5797;fontSize=13;arcSize=10;fontFamily=Segoe UI;fontColor=#1B2733;align=center;strokeWidth=1.5;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="250" width="480" height="62" as="geometry"/></mxCell><mxCell id="s4" value="&lt;b&gt;4 · kernel_modules.yml (modules)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#4A5868&quot;&gt;unused filesystems + usb-storage denied&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#4A5868&quot;&gt;iso9660 / overlay protected&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF1FB;strokeColor=#2B5797;fontSize=13;arcSize=10;fontFamily=Segoe UI;fontColor=#1B2733;align=center;strokeWidth=1.5;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="330" width="480" height="62" as="geometry"/></mxCell><mxCell id="s5" value="&lt;b&gt;5 · mounts.yml (mounts)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#4A5868&quot;&gt;/tmp, /dev/shm nodev,nosuid,noexec&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#4A5868&quot;&gt;fstab · /tmp applies at reboot&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF1FB;strokeColor=#2B5797;fontSize=13;arcSize=10;fontFamily=Segoe UI;fontColor=#1B2733;align=center;strokeWidth=1.5;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="410" width="480" height="62" as="geometry"/></mxCell><mxCell id="s6" value="&lt;b&gt;6 · apt.yml (apt)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#4A5868&quot;&gt;debconf templates off /tmp&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#4A5868&quot;&gt;package installs keep working&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF1FB;strokeColor=#2B5797;fontSize=13;arcSize=10;fontFamily=Segoe UI;fontColor=#1B2733;align=center;strokeWidth=1.5;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="490" width="480" height="62" as="geometry"/></mxCell><mxCell id="s7" value="&lt;b&gt;7 · sysctl.yml (sysctl)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#4A5868&quot;&gt;network / kernel hardening · no core dumps&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#4A5868&quot;&gt;ufw loads the CIS sysctl file&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF1FB;strokeColor=#2B5797;fontSize=13;arcSize=10;fontFamily=Segoe UI;fontColor=#1B2733;align=center;strokeWidth=1.5;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="570" width="480" height="62" as="geometry"/></mxCell><mxCell id="s8" value="&lt;b&gt;8 · bootloader.yml (grub)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#4A5868&quot;&gt;AppArmor on cmdline · grub.cfg 0600&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#4A5868&quot;&gt;optional password, --unrestricted&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF1FB;strokeColor=#2B5797;fontSize=13;arcSize=10;fontFamily=Segoe UI;fontColor=#1B2733;align=center;strokeWidth=1.5;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="650" width="480" height="62" as="geometry"/></mxCell><mxCell id="s9" value="&lt;b&gt;9 · time.yml (time)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#4A5868&quot;&gt;chrony · optional internal NTP servers&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF1FB;strokeColor=#2B5797;fontSize=13;arcSize=10;fontFamily=Segoe UI;fontColor=#1B2733;align=center;strokeWidth=1.5;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="730" width="480" height="62" as="geometry"/></mxCell><mxCell id="s10" value="&lt;b&gt;10 · sshd.yml (ssh)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#4A5868&quot;&gt;drop-in 00-cis-hardening.conf · sshd -t&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#4A5868&quot;&gt;rollback on error · reconnect test&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDECEA;strokeColor=#C62828;fontSize=13;arcSize=10;fontFamily=Segoe UI;fontColor=#1B2733;align=center;strokeWidth=1.5;spacing=6;" vertex="1" parent="1"><mxGeometry x="640" y="90" width="480" height="62" as="geometry"/></mxCell><mxCell id="s11" value="&lt;b&gt;11 · sudo.yml (sudo)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#4A5868&quot;&gt;use_pty · timestamp timeout&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#4A5868&quot;&gt;sudo-rs aware (journald logging)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF1FB;strokeColor=#2B5797;fontSize=13;arcSize=10;fontFamily=Segoe UI;fontColor=#1B2733;align=center;strokeWidth=1.5;spacing=6;" vertex="1" parent="1"><mxGeometry x="640" y="170" width="480" height="62" as="geometry"/></mxCell><mxCell id="s12" value="&lt;b&gt;12 · accounts.yml (accounts, pam)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#4A5868&quot;&gt;aging · pwquality · faillock · pwhistory&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#4A5868&quot;&gt;TMOUT · umask 027&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF1FB;strokeColor=#2B5797;fontSize=13;arcSize=10;fontFamily=Segoe UI;fontColor=#1B2733;align=center;strokeWidth=1.5;spacing=6;" vertex="1" parent="1"><mxGeometry x="640" y="250" width="480" height="62" as="geometry"/></mxCell><mxCell id="s13" value="&lt;b&gt;13 · misc.yml (misc)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#4A5868&quot;&gt;banners · cron/at root-only&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#4A5868&quot;&gt;persistent journald · AppArmor&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF1FB;strokeColor=#2B5797;fontSize=13;arcSize=10;fontFamily=Segoe UI;fontColor=#1B2733;align=center;strokeWidth=1.5;spacing=6;" vertex="1" parent="1"><mxGeometry x="640" y="330" width="480" height="62" as="geometry"/></mxCell><mxCell id="s14" value="&lt;b&gt;14 · vmware.yml (vmware, optional)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#4A5868&quot;&gt;open-vm-tools · cloud-init datasources&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#607D8B;fontSize=13;arcSize=10;fontFamily=Segoe UI;fontColor=#1B2733;align=center;strokeWidth=1.5;spacing=6;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="640" y="410" width="480" height="62" as="geometry"/></mxCell><mxCell id="s15" value="&lt;b&gt;15 · aide.yml (aide)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#4A5868&quot;&gt;AIDE · baseline in background · daily timer&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF1FB;strokeColor=#2B5797;fontSize=13;arcSize=10;fontFamily=Segoe UI;fontColor=#1B2733;align=center;strokeWidth=1.5;spacing=6;" vertex="1" parent="1"><mxGeometry x="640" y="490" width="480" height="62" as="geometry"/></mxCell><mxCell id="s16" value="&lt;b&gt;16 · firewall.yml (firewall)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#4A5868&quot;&gt;arm rollback timer → rules → enable&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#4A5868&quot;&gt;reconnect → cancel timer&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDECEA;strokeColor=#C62828;fontSize=13;arcSize=10;fontFamily=Segoe UI;fontColor=#1B2733;align=center;strokeWidth=1.5;spacing=6;" vertex="1" parent="1"><mxGeometry x="640" y="570" width="480" height="62" as="geometry"/></mxCell><mxCell id="s17" value="&lt;b&gt;17 · summary.yml (always)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px