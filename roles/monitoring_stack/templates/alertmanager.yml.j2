# {{ ansible_managed }} (role monitoring_stack)
# Automation first, humans when automation gives up. The timing lives in the
# Prometheus rules ("for"), not here: Alertmanager only routes.
#   selfheal="true"  -> eda-selfheal (ansible-rulebook)
#   anything else    -> on-call (SelfHealServiceDownTooLong, SelfHealTargetDown)
# group_by includes the unit and the host, so every incident is its own group.
route:
  receiver: on-call
  group_by: [alertname, inventory_hostname, name]
  group_wait: 0s
  group_interval: 30s
  repeat_interval: 4h
  routes:
    - receiver: eda-selfheal
      matchers: ['selfheal="true"']
      group_interval: 10s
      repeat_interval: {{ monitoring_eda_repeat_interval }}

receivers:
  # ansible-rulebook, source ansible.eda.alertmanager (role eda_rulebook).
  - name: eda-selfheal
    webhook_configs:
      - url: {{ monitoring_eda_webhook }}
        send_resolved: true
  # Lab stand-in for PagerDuty / Opsgenie / Teams: the "On-call pager"
  # ruleset of the same rulebook logs every page to its journal.
  - name: on-call
    webhook_configs:
      - url: {{ monitoring_oncall_webhook }}
        send_resolved: true
