# {{ ansible_managed }} (role monitoring_stack)
global:
  scrape_interval: {{ monitoring_scrape_interval }}
  evaluation_interval: {{ monitoring_evaluation_interval }}

alerting:
  alertmanagers:
    - static_configs:
        - targets: ["{{ monitoring_alertmanager_listen }}"]

rule_files:
  - /etc/prometheus/rules/*.yml

scrape_configs:
  - job_name: prometheus
    static_configs:
      - targets: ["{{ monitoring_prometheus_listen }}"]

  # One target per host of the inventory group; the label inventory_hostname
  # travels with every alert, so the rulebook knows which host to --limit.
  - job_name: selfheal_targets
{% set _hosts = groups[monitoring_target_group] | default([]) %}
{% if _hosts | length == 0 %}
    static_configs: []
{% else %}
    static_configs:
{% for _host in _hosts %}
      - targets: ["{{ hostvars[_host].selfheal_exporter_target }}"]
        labels:
          inventory_hostname: "{{ _host }}"
{% endfor %}
{% endif %}
