<!doctype html>
<!-- {{ ansible_managed }} (role nginx_web) -->
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ nginx_web_title }}</title>
  <style>
    body { font-family: system-ui, sans-serif; margin: 0; min-height: 100vh; display: grid; place-items: center; background: #0f172a; color: #e2e8f0; }
    main { text-align: center; padding: 2rem; }
    h1 { font-size: 2rem; margin: 0 0 .5rem; }
    p { margin: .25rem 0; color: #94a3b8; }
    code { color: #38bdf8; }
  </style>
</head>
<body>
  <main>
    <h1>{{ nginx_web_title }}</h1>
    <p>Served by <code>{{ inventory_hostname }}</code> with nginx.</p>
    <p>If this page is down, Prometheus notices, Event-Driven Ansible reacts and Ascender heals it.</p>
  </main>
</body>
</html>
