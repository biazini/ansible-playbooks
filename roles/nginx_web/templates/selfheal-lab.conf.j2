# {{ ansible_managed }} (role nginx_web)
server {
    listen {{ nginx_web_port }} default_server;
    listen [::]:{{ nginx_web_port }} default_server;
    server_name _;

    root /var/www/html;
    index index.html;

    # No version in the Server header. Set at server level: Ubuntu 26.04
    # already sets it in nginx.conf (http level), and a second http-level
    # server_tokens is a "duplicate directive" error.
    server_tokens off;

    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;

    # Used by the self-healing verification step and by load balancers.
    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    location / {
        try_files $uri $uri/ =404;
    }
}
