# {{ ansible_managed }} (role nginx_web)
server {
    listen {{ nginx_web_port }} default_server;
    listen [::]:{{ nginx_web_port }} default_server;
    server_name _;

    root /var/www/html;
    index index.html;

    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;

    # Used by the self-healing verification step and by load balancers.
    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    location / {
        try_files $uri $uri/ =404;
    }
}
