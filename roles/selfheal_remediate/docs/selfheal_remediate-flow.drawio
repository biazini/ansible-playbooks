; color=&#x27;#5A6573&#x27;&gt;systemd state &amp;middot; down since&lt;br&gt;last journal lines&lt;br&gt;(evidence in the job log)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF1FB;strokeColor=#2B5797;fontSize=12;arcSize=8;fontFamily=Segoe UI;fontColor=#1B2733;align=center;strokeWidth=1.5;spacing=6;" vertex="1" parent="lane"><mxGeometry x="470" y="40" width="200" height="115" as="geometry"/></mxCell><mxCell id="a2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;strokeColor=#607D8B;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=10;fontColor=#607D8B;fontFamily=Segoe UI;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=8;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="s2" target="s3"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="xs3" value="&lt;b&gt;NO ACTION&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27; color=&#x27;#5A6573&#x27;&gt;unit already active&lt;br&gt;(duplicate event, recovered)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECEFF1;strokeColor=#607D8B;fontSize=12;arcSize=8;fontFamily=Segoe UI;fontColor=#1B2733;align=center;strokeWidth=1.5;spacing=6;" vertex="1" parent="1"><mxGeometry x="480" y="300" width="200" height="80" as="geometry"/></mxCell><mxCell id="bs3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;strokeColor=#607D8B;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=10;fontColor=#607D8B;fontFamily=Segoe UI;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=8;dashed=1;dashPattern=6 4;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s3" target="xs3"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="s4" value="&lt;b&gt;breaker.yml&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27; color=&#x27;#5A6573&#x27;&gt;automatic launches only:&lt