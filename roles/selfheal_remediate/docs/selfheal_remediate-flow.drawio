Color=#EAF1FB;strokeColor=#2B5797;fontSize=12;arcSize=8;fontFamily=Segoe UI;fontColor=#1B2733;align=center;strokeWidth=1.5;spacing=6;" vertex="1" parent="lane"><mxGeometry x="930" y="40" width="200" height="115" as="geometry"/></mxCell><mxCell id="a4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;strokeColor=#607D8B;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=10;fontColor=#607D8B;fontFamily=Segoe UI;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=8;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="s4" target="s5"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="xs5" value="&lt;b&gt;ESCALATE&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27; color=&#x27;#5A6573&#x27;&gt;broken configuration&lt;br&gt;error in the job log&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDECEA;strokeColor=#C62828;fontSize=12;arcSize=8;fontFamily=Segoe UI;fontColor=#1B2733;align=center;strokeWidth=1.5;spacing=6;" vertex="1" parent="1"><mxGeometry x="940" y="300" width="200" height="80" as="geometry"/></mxCell><mxCell id="bs5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;strokeColor=#C62828;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=10;fontColor=#C62828;fontFamily=Segoe UI;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=8;dashed=1;dashPattern=6 4;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s5" target="xs5"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="s6" value="&lt;b&gt;heal.yml&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27; color=&#x27;#5A6573&#x27;&gt;record restart (automatic)&lt;br&gt;systemctl restart&lt;br&gt;logger --tag selfheal&lt;br&gt;verify: active + /healthz&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF1FB;strokeColor=#2B5797;fontSize=12;arcSize=8;fontFamily=Segoe UI;fontColor=#1B2733;align=center;strokeWidth=1.5;spacing=6;" vertex="1" parent="lane"><mxGeometry x="1160" y="40" width="200" height="115" as="geometry"/></mxCell><mxCell id="a5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;strokeColor=#607D8B;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=10;fontColor=#607D8B;fontFamily=Segoe UI;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=8;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="s5" target="s6"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="xs6" value="&lt;b&gt;ESCALATE&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27; color=&#x27;#5A6573&#x27;&gt;restart did not heal&lt;br&gt;journal attached&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDECEA;strokeColor=#C62828;fontSize=12;arcSize=8;fontFamily=Segoe UI;fontColor=#1B2733;align=center;strokeWidth=1.5;spacing=6;" vertex="1" parent="1"><mxGeometry x="1170" y="300" width="200" height="80" as="geometry"/></mxCell><mxCell id="bs6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;strokeColor=#C62828;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=10;fontColor=#C62828;fontFamily=Segoe UI;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=8;dashed=1;dashPattern=6 4;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s6" target="xs6"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="s7" value="&lt;b&gt;report.yml&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27; color=&#x27;#5A6573&#x27;&gt;down &amp;rarr; alert &amp;rarr; healthy&lt;br&gt;outage seconds&lt;br&gt;set_stats for Ascender&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF1FB;strokeColor=#2B5797;fontSize=12;arcSize=8;fontFamily=Segoe UI;fontColor=#1B2733;align=center;strokeWidth=1.5;spacing=6;" vertex="1" parent="lane"><mxGeometry x="1390" y="40" width="200" height="115" as="geometry"/></mxCell><mxCell id="a6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;strokeColor=#607D8B;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=10;fontColor=#607D8B;fontFamily=Segoe UI;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=8;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="s6" target="s7"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="xs7" value="&lt;b&gt;HEALED&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27; color=&#x27;#5A6573&#x27;&gt;outage &amp;middot; detection&lt;br&gt;remediation seconds&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;fontSize=12;arcSize=8;fontFamily=Segoe UI;fontColor=#1B2733;align=center;strokeWidth=1.5;spacing=6;" vertex="1" parent="1"><mxGeometry x="1400" y="300" width="200" height="80" as="geometry"/></mxCell><mxCell id="bs7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;strokeColor=#2E7D32;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=10;fontColor=#2E7D32;fontFamily=Segoe UI;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=8;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s7" target="xs7"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="why" value="&lt;b&gt;What happens after ESCALATE&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFBFD;strokeColor=#C62828;fontSize=12;arcSize=1;fontFamily=Segoe UI;fontColor=#1B2733;align=left;verticalAlign=top;spacingTop=4;spacingLeft=8;container=1;collapsible=0;fontStyle=1;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="10" y="420" width="1600" height="110" as="geometry"/></mxCell><mxCell id="w1" value="&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27; color=&#x27;#5A6573&#x27;&gt;The job fails on purpose and the unit stays down. Prometheus keeps SelfHealServiceDown firing, and after 2 minutes SelfHealServiceDownTooLong pages on-call: escalation needs no message from the automation, so it works even when EDA or Ascender is down.&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;fontColor=#4A5868;fontFamily=Segoe UI;" vertex="1" parent="why"><mxGeometry x="20" y="35" width="760" height="60" as="geometry"/></mxCell><mxCell id="w2" value="&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27; color=&#x27;#5A6573&#x27;&gt;The human fixes the cause, then launches Self-Heal - Remediate service with limit &amp;lt;host&amp;gt;, selfheal_service=&amp;lt;unit&amp;gt; and selfheal_reset_breaker=true: the history is cleared, the unit is restarted and verified, and the alert resolves for EDA and on-call.&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;fontColor=#4A5868;fontFamily=Segoe UI;" vertex="1" parent="why"><mxGeometry x="810" y="35" width="770" height="60" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>