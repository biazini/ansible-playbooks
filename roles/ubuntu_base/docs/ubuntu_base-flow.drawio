<mxfile host="vscode" agent="diagrams.py"><diagram id="ubuntu_base-flow" name="ubuntu_base-flow"><mxGraphModel dx="1640" dy="640" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1640" pageHeight="640" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Role ubuntu_base — Task Flow" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#1F3A5F;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="20" y="8" width="1200" height="34" as="geometry"/></mxCell><mxCell id="subtitle" value="tasks/main.yml · keyboard.yml → initramfs.yml → verify.yml · handlers run once: one initramfs rebuild for both areas" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#4A5868;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="20" y="40" width="1200" height="20" as="geometry"/></mxCell><mxCell id="ck" value="keyboard.yml  (tag: keyboard)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFBFD;strokeColor=#1565C0;fontSize=13;arcSize=1;fontFamily=Segoe UI;fontColor=#1B2733;align=left;verticalAlign=top;spacingTop=4;spacingLeft=8;fontStyle=1;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="20" y="80" width="510" height="330" as="geometry"/></mxCell><mxCell id="k1" value="&lt;b&gt;/etc/default/keyboard&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#4A5868&quot;&gt;XKBMODEL=pc105 · XKBLAYOUT=pt&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#4A5868&quot;&gt;site values: inventories/&amp;lt;env&amp;gt;/group_vars&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF1FB;strokeColor=#2B5797;fontSize=13;arcSize=10;fontFamily=Segoe UI;fontColor=#1B2733;align=center;strokeWidth=1.5;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="125" width="470" height="72" as="geometry"/></mxCell><mxCell id="k2" value="&lt;b&gt;debconf: keyboard-configuration&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#4A5868&quot;&gt;modelcode · layoutcode (…)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#4A5868&quot;&gt;upgrades keep the layout&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF1FB;strokeColor=#2B5797;fontSize=13;arcSize=10;fontFamily=Segoe UI;fontColor=#1B2733;align=center;strokeWidth=1.5;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="217" width="470" height="72" as="geometry"/></mxCell><mxCell id="k3" value="&lt;b&gt;handler: Apply console keyboard&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#4A5868&quot;&gt;setupcon --save-only → cached_UTF-8_del.kmap&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#4A5868&quot;&gt;restart keyboard-setup → tty1 now&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFDE7;strokeColor=#B08800;fontSize=13;arcSize=10;fontFamily=Segoe UI;fontColor=#1B2733;align=center;strokeWidth=1.5;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="309" width="470" height="72" as="geometry"/></mxCell><mxCell id="ek1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;strokeColor=#607D8B;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#607D8B;fontFamily=Segoe UI;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=8;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="k1" target="k2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ek2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;strokeColor=#607D8B;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#607D8B;fontFamily=Segoe UI;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=8;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="k2" target="k3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ci" value="initramfs.yml  (tag: initramfs)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFBFD;strokeColor=#1565C0;fontSize=13;arcSize=1;fontFamily=Segoe UI;fontColor=#1B2733;align=left;verticalAlign=top;spacingTop=4;spacingLeft=8;fontStyle=1;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="565" y="80" width="510" height="330" as="geometry"/></mxCell><mxCell id="i1" value="&lt;b&gt;dracut present · overlayroot unused&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#4A5868&quot;&gt;refuses to omit overlayroot while it is configured&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDECEA;strokeColor=#C62828;fontSize=13;arcSize=10;fontFamily=Segoe UI;fontColor=#1B2733;align=center;strokeWidth=1.5;spacing=6;" vertex="1" parent="1"><mxGeometry x="585" y="125" width="470" height="72" as="geometry"/></mxCell><mxCell id="i2" value="&lt;b&gt;/etc/dracut.conf.d/90-ubuntu-base-omit.conf&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#4A5868&quot;&gt;omit_dracutmodules+=&quot; copymods overlayroot &quot;&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF1FB;strokeColor=#2B5797;fontSize=13;arcSize=10;fontFamily=Segoe UI;fontColor=#1B2733;align=center;strokeWidth=1.5;spacing=6;" vertex="1" parent="1"><mxGeometry x="585" y="217" width="470" height="72" as="geometry"/></mxCell><mxCell id="i3" value="&lt;b&gt;handler: Rebuild initramfs&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#4A5868&quot;&gt;dracut --force --regenerate-all&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#4A5868&quot;&gt;includes the new console keymap&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFDE7;strokeColor=#B08800;fontSize=13;arcSize=10;fontFamily=Segoe UI;fontColor=#1B2733;align=center;strokeWidth=1.5;spacing=6;" vertex="1" parent="1"><mxGeometry x="585" y="309" width="470" height="72" as="geometry"/></mxCell><mxCell id="ei1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;strokeColor=#607D8B;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#607D8B;fontFamily=Segoe UI;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=8;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="i1" target="i2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ei2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;strokeColor=#607D8B;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#607D8B;fontFamily=Segoe UI;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=8;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="i2" target="i3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="cv" value="verify.yml  (always)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFBFD;strokeColor=#2E7D32;fontSize=13;arcSize=1;fontFamily=Segoe UI;fontColor=#1B2733;align=left;verticalAlign=top;spacingTop=4;spacingLeft=8;fontStyle=1;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="20" y="440" width="1055" height="180" as="geometry"/></mxCell><mxCell id="v1" value="&lt;b&gt;flush_handlers&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#4A5868&quot;&gt;save + reload keymap&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#4A5868&quot;&gt;one initramfs rebuild&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFDE7;strokeColor=#B08800;fontSize=13;arcSize=10;fontFamily=Segoe UI;fontColor=#1B2733;align=center;strokeWidth=1.5;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="485" width="320" height="110" as="geometry"/></mxCell><mxCell id="v2" value="&lt;b&gt;localectl status&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#4A5868&quot;&gt;X11 Layout: pt&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;fontSize=13;arcSize=10;fontFamily=Segoe UI;fontColor=#1B2733;align=center;strokeWidth=1.5;spacing=6;" vertex="1" parent="1"><mxGeometry x="385" y="485" width="320" height="110" as="geometry"/></mxCell><mxCell id="v3" value="&lt;b&gt;lsinitrd -m&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#4A5868&quot;&gt;copymods / overlayroot absent&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#4A5868&quot;&gt;new image used at next boot&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;fontSize=13;arcSize=10;fontFamily=Segoe UI;fontColor=#1B2733;align=center;strokeWidth=1.5;spacing=6;" vertex="1" parent="1"><mxGeometry x="730" y="485" width="325" height="110" as="geometry"/></mxCell><mxCell id="ev1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;strokeColor=#607D8B;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#607D8B;fontFamily=Segoe UI;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=8;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="v1" target="v2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ev2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;strokeColor=#607D8B;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#607D8B;fontFamily=Segoe UI;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=8;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="v2" target="v3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_kv" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;strokeColor=#607D8B;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#607D8B;fontFamily=Segoe UI;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=8;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.24170616113744076;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="ck" target="cv"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_iv" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;strokeColor=#607D8B;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#607D8B;fontFamily=Segoe UI;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=8;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.7582938388625592;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="ci" target="cv"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="why" value="Why" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFBFD;strokeColor=#555555;fontSize=14;arcSize=1;fontFamily=Segoe UI;fontColor=#1B2733;align=left;verticalAlign=top;spacingTop=4;spacingLeft=8;fontStyle=1;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1110" y="80" width="510" height="540" as="geometry"/></mxCell><mxCell id="m0" value="&lt;b&gt;Keyboard: one file, three consumers&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#4A5868&quot;&gt;localectl reads /etc/default/keyboard ·&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#4A5868&quot;&gt;keyboard-setup loads it at boot (tty) · dracut&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#4A5868&quot;&gt;copies the compiled keymap (emergency shell)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#607D8B;fontSize=13;arcSize=10;fontFamily=Segoe UI;fontColor=#1B2733;align=center;strokeWidth=1.5;spacing=6;" vertex="1" parent="1"><mxGeometry x="1130" y="125" width="470" height="120" as="geometry"/></mxCell><mxCell id="m1" value="&lt;b&gt;copymods  (cloud-initramfs-copymods)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#4A5868&quot;&gt;prints 'copymods is deprecated' and&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#4A5868&quot;&gt;'/lib/modules/&amp;lt;kver&amp;gt; exists' on every boot&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#607D8B;fontSize=13;arcSize=10;fontFamily=Segoe UI;fontColor=#1B2733;align=center;strokeWidth=1.5;spacing=6;" vertex="1" parent="1"><mxGeometry x="1130" y="265" width="470" height="110" as="geometry"/></mxCell><mxCell id="m2" value="&lt;b&gt;overlayroot  (overlayroot)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#4A5868&quot;&gt;compat hook fails on a normal root:&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#4A5868&quot;&gt;ln: /sysroot/media/root-ro: Read-only&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#607D8B;fontSize=13;arcSize=10;fontFamily=Segoe UI;fontColor=#1B2733;align=center;strokeWidth=1.5;spacing=6;" vertex="1" parent="1"><mxGeometry x="1130" y="395" width="470" height="110" as="geometry"/></mxCell><mxCell id="m3" value="&lt;b&gt;Packages stay installed&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#4A5868&quot;&gt;only configuration and the initramfs change&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFDE7;strokeColor=#B08800;fontSize=13;arcSize=10;fontFamily=Segoe UI;fontColor=#1B2733;align=center;strokeWidth=1.5;spacing=6;" vertex="1" parent="1"><mxGeometry x="1130" y="525" width="470" height="75" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
