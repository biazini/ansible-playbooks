<mxfile host="vscode" agent="diagrams.py"><diagram id="ubuntu_base-flow" name="ubuntu_base-flow"><mxGraphModel dx="1100" dy="560" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="560" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Role ubuntu_base — Task Flow" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#1F3A5F;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="20" y="8" width="1200" height="34" as="geometry"/></mxCell><mxCell id="subtitle" value="tasks/initramfs.yml (tag: initramfs) · unused dracut modules out of the initramfs · effective at the next boot" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#4A5868;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="20" y="40" width="1200" height="20" as="geometry"/></mxCell><mxCell id="b1" value="&lt;b&gt;1 · Is dracut the initramfs generator&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#4A5868&quot;&gt;stat /usr/bin/dracut · otherwise nothing to do&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF1FB;strokeColor=#2B5797;fontSize=13;arcSize=10;fontFamily=Segoe UI;fontColor=#1B2733;align=center;strokeWidth=1.5;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="470" height="62" as="geometry"/></mxCell><mxCell id="b2" value="&lt;b&gt;2 · overlayroot not in use&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#4A5868&quot;&gt;/etc/overlayroot.conf empty or disabled&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#4A5868&quot;&gt;no overlayroot / rd.overlay on the kernel cmdline&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDECEA;strokeColor=#C62828;fontSize=13;arcSize=10;fontFamily=Segoe UI;fontColor=#1B2733;align=center;strokeWidth=1.5;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="166" width="470" height="62" as="geometry"/></mxCell><mxCell id="b3" value="&lt;b&gt;3 · /etc/dracut.conf.d/90-ubuntu-base-omit.conf&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#4A5868&quot;&gt;omit_dracutmodules+=&quot; copymods overlayroot &quot;&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF1FB;strokeColor=#2B5797;fontSize=13;arcSize=10;fontFamily=Segoe UI;fontColor=#1B2733;align=center;strokeWidth=1.5;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="242" width="470" height="62" as="geometry"/></mxCell><mxCell id="b4" value="&lt;b&gt;4 · handler: dracut --force --regenerate-all&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#4A5868&quot;&gt;rebuilds the initramfs of every kernel&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFDE7;strokeColor=#B08800;fontSize=13;arcSize=10;fontFamily=Segoe UI;fontColor=#1B2733;align=center;strokeWidth=1.5;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="318" width="470" height="62" as="geometry"/></mxCell><mxCell id="b5" value="&lt;b&gt;5 · lsinitrd -m&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#4A5868&quot;&gt;omitted modules are no longer in the image&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;fontSize=13;arcSize=10;fontFamily=Segoe UI;fontColor=#1B2733;align=center;strokeWidth=1.5;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="394" width="470" height="62" as="geometry"/></mxCell><mxCell id="b6" value="&lt;b&gt;6 · reboot (maintenance window)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#4A5868&quot;&gt;or base_allow_reboot: true&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#607D8B;fontSize=13;arcSize=10;fontFamily=Segoe UI;fontColor=#1B2733;align=center;strokeWidth=1.5;spacing=6;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="40" y="470" width="470" height="62" as="geometry"/></mxCell><mxCell id="e_b1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;strokeColor=#607D8B;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#607D8B;fontFamily=Segoe UI;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=8;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="b1" target="b2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_b2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;strokeColor=#607D8B;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#607D8B;fontFamily=Segoe UI;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=8;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="b2" target="b3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_b3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;strokeColor=#607D8B;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#607D8B;fontFamily=Segoe UI;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=8;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="b3" target="b4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_b4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;strokeColor=#607D8B;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#607D8B;fontFamily=Segoe UI;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=8;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="b4" target="b5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_b5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;strokeColor=#607D8B;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#607D8B;fontFamily=Segoe UI;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=8;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="b5" target="b6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="why" value="Why these modules are omitted" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFBFD;strokeColor=#555555;fontSize=14;arcSize=1;fontFamily=Segoe UI;fontColor=#1B2733;align=left;verticalAlign=top;spacingTop=4;spacingLeft=8;fontStyle=1;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="560" y="90" width="500" height="442" as="geometry"/></mxCell><mxCell id="m1" value="&lt;b&gt;copymods  (cloud-initramfs-copymods)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#4A5868&quot;&gt;copies kernel modules into a root that has none&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#4A5868&quot;&gt;(some cloud images) · prints on every boot:&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#4A5868&quot;&gt;'copymods' is deprecated · /lib/modules/&amp;lt;kver&amp;gt; exists&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#607D8B;fontSize=13;arcSize=10;fontFamily=Segoe UI;fontColor=#1B2733;align=center;strokeWidth=1.5;spacing=6;" vertex="1" parent="1"><mxGeometry x="580" y="135" width="460" height="120" as="geometry"/></mxCell><mxCell id="m2" value="&lt;b&gt;overlayroot  (overlayroot)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#4A5868&quot;&gt;read-only root with a writable overlay · its&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#4A5868&quot;&gt;compat hook always runs and fails on a normal root:&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#4A5868&quot;&gt;ln: /sysroot/media/root-ro: Read-only file system&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#607D8B;fontSize=13;arcSize=10;fontFamily=Segoe UI;fontColor=#1B2733;align=center;strokeWidth=1.5;spacing=6;" vertex="1" parent="1"><mxGeometry x="580" y="275" width="460" height="120" as="geometry"/></mxCell><mxCell id="m3" value="&lt;b&gt;Packages stay installed&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#4A5868&quot;&gt;only the initramfs changes · remove a name from&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#4A5868&quot;&gt;base_dracut_omit_modules to keep a module&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFDE7;strokeColor=#B08800;fontSize=13;arcSize=10;fontFamily=Segoe UI;fontColor=#1B2733;align=center;strokeWidth=1.5;spacing=6;" vertex="1" parent="1"><mxGeometry x="580" y="415" width="460" height="92" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
